root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
max_line_length = 140

# ktlint rules
ktlint_standard = enabled
ktlint_experimental = disabled

# Spring Boot는 많은 패키지 import가 필요 — wildcard 금지는 유지
ij_kotlin_name_count_to_use_star_import = 2147483647
ij_kotlin_name_count_to_use_star_import_for_members = 2147483647
ij_kotlin_packages_to_use_import_on_demand = unset

# trailing comma 허용 (프로젝트 컨벤션)
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

# function naming — 테스트에서만 백틱 백킹된 긴 이름 허용
ktlint_function_naming_ignore_when_annotated_with = Test, ParameterizedTest, RepeatedTest, TestFactory

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
